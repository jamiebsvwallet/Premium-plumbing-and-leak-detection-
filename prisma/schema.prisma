// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("user") // "user", "operator", "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices      Device[]
  consentGrants ConsentGrant[]
  jobReports    JobReport[]
}

model Device {
  id          String   @id @default(uuid())
  name        String
  type        String   // "water_heater", "pipe_sensor", etc.
  serialNumber String  @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events       DeviceEvent[]
  consentGrants ConsentGrant[]
}

model DeviceEvent {
  id           String   @id @default(uuid())
  deviceId     String
  eventType    String   // "temperature", "pressure", "leak_detected", etc.
  value        Float?
  metadata     String?  // JSON string for additional data
  timestamp    DateTime @default(now())
  anchorStatus String   @default("pending") // "pending", "anchored", "failed"
  bsvTxId      String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
}

model ConsentGrant {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  grantedTo  String   // email or user ID of operator
  scope      String   @default("read") // "read", "write"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, grantedTo])
  @@index([grantedTo, active])
}

model AnchorJob {
  id        String   @id @default(uuid())
  eventIds  String   // JSON array of event IDs
  status    String   @default("pending") // "pending", "processing", "completed", "failed"
  bsvTxId   String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model JobReport {
  id          String   @id @default(uuid())
  userId      String
  deviceId    String?
  title       String
  description String
  status      String   @default("open") // "open", "in_progress", "completed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
