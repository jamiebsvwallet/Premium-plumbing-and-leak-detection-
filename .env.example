# Database
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="your-secret-key-change-in-production"

# Server Configuration
SERVER_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# BSV Blockchain (Optional - leave empty for stub mode)
# BSV_PRIVATE_KEY="your-bsv-private-key-wif-format"
# BSV_BROADCAST_ENDPOINT="https://api.whatsonchain.com/v1/bsv/main/tx/raw"

# MoneyButton (Optional)
# MONEYBUTTON_CLIENT_ID=""
# MONEYBUTTON_CLIENT_SECRET=""

# SendGrid Email (Optional)
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="noreply@example.com"

# Email Configuration (nodemailer)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USER="user@example.com"
EMAIL_PASSWORD="password"
EMAIL_FROM="noreply@example.com"
