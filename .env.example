# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-secret-key-change-in-production"

# BSV Configuration (optional - for blockchain anchoring)
# Leave empty or use testnet private key for testing
BSV_PRIVATE_KEY=""
BSV_NETWORK="testnet"

# MoneyButton Configuration (optional - for frontend BSV integration)
MONEYBUTTON_CLIENT_ID=""
MONEYBUTTON_CLIENT_SECRET=""

# Email Configuration (for job report notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Socket.IO Server URL (frontend)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Render Configuration (for production Socket.IO server)
# Set PORT environment variable on Render for the Socket server
PORT="3001"
