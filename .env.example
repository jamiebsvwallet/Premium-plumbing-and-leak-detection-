# Environment variables for Premium Plumbing Leak Detection MVP

# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-secret-key-change-in-production"

# BSV Configuration (Testnet)
BSV_PRIVATE_KEY="your-testnet-private-key"
BSV_NETWORK="testnet"
# Alternative: Use MoneyButton for client-side signing
MONEYBUTTON_CLIENT_ID="your-moneybutton-client-id"
MONEYBUTTON_CLIENT_SECRET="your-moneybutton-client-secret"

# Email Configuration (optional for MVP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="noreply@example.com"

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
