# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (change this in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Server Configuration
SERVER_PORT=3001

# Socket.IO URL (for frontend to connect to backend)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# BSV Blockchain Configuration (optional - uses stub if not provided)
BSV_PRIVATE_KEY=""
BSV_BROADCAST_ENDPOINT=""

# MoneyButton Configuration (optional - for future BSV integration)
MONEYBUTTON_API_KEY=""
MONEYBUTTON_API_SECRET=""

# SendGrid Email Configuration (optional - for report delivery)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
