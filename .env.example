# Environment variables
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"

# BSV Integration (optional - for blockchain anchoring)
# BSV_PRIVATE_KEY=""
# BSV_NETWORK="testnet"

# MoneyButton Integration (optional)
# MONEYBUTTON_CLIENT_ID=""
# MONEYBUTTON_CLIENT_SECRET=""

# Email Configuration (optional - for job reports)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@premiumplumbing.com"

# Render Deployment Settings
# SOCKET_SERVER_URL="https://your-render-app.onrender.com"
# PORT="3001"

# Frontend URL (for CORS)
# FRONTEND_URL="http://localhost:3000"
