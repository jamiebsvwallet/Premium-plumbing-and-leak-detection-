# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server Configuration
SERVER_PORT=4000
NODE_ENV=development

# Socket.IO (used by frontend to connect to backend)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# BSV Configuration (optional - leave empty for stub/fake mode)
# Only set these if you want real BSV broadcasting
BSV_PRIVATE_KEY=""
BSV_BROADCAST_ENDPOINT=""

# MoneyButton API (optional - for future payment features)
MONEYBUTTON_CLIENT_ID=""
MONEYBUTTON_CLIENT_SECRET=""

# SendGrid (optional - for email notifications)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
