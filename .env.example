# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a secure random string for production)
JWT_SECRET="your-jwt-secret-change-this-in-production"

# BSV Configuration (optional - for blockchain anchoring)
# Leave empty to run in stub mode without broadcasting
BSV_PRIVATE_KEY=""
BSV_NETWORK="testnet"

# MoneyButton Integration (optional)
MONEYBUTTON_CLIENT_ID=""
MONEYBUTTON_CLIENT_SECRET=""

# Email Configuration (optional - for job report notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Socket.IO Server URL (for realtime updates)
# In production, set this to your Render backend URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Render Configuration (for deployment)
# Set this in Render dashboard environment variables
PORT="3001"
