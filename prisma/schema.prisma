// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum AnchorStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices          Device[]
  consentsGranted  Consent[]  @relation("ConsentOwner")
  consentsReceived Consent[]  @relation("ConsentOperator")
  jobReports       JobReport[]
}

model Device {
  id          String   @id @default(cuid())
  name        String
  type        String?
  location    String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User          @relation(fields: [ownerId], references: [id])
  events      DeviceEvent[]
  consents    Consent[]
  jobReports  JobReport[]
}

model DeviceEvent {
  id           String       @id @default(cuid())
  deviceId     String
  timestamp    DateTime
  metrics      String       // JSON string
  alertType    String?
  rawPayload   String       // JSON string
  sha256       String       @unique
  anchorStatus AnchorStatus @default(PENDING)
  bsvTxId      String?
  createdAt    DateTime     @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, timestamp])
  @@index([anchorStatus])
}

model Consent {
  id         String   @id @default(cuid())
  ownerId    String
  operatorId String
  deviceId   String?
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User    @relation("ConsentOwner", fields: [ownerId], references: [id])
  operator User    @relation("ConsentOperator", fields: [operatorId], references: [id])
  device   Device? @relation(fields: [deviceId], references: [id])

  @@unique([ownerId, operatorId, deviceId])
}

model JobReport {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String
  operatorId  String
  title       String
  description String
  pdfPath     String?
  bsvTxId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id])
  device   Device @relation(fields: [deviceId], references: [id])
}
