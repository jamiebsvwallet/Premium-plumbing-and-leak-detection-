# Database
DATABASE_URL="file:./dev.db"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-secure-jwt-secret-change-this-in-production"

# Server Configuration
PORT=4000
NODE_ENV=development

# Next.js Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# BSV Broadcasting (optional - leave empty to use fake txid)
# BSV_PRIVATE_KEY=your_private_key_here
# BSV_NETWORK=mainnet
# BSV_API_URL=https://api.whatsonchain.com/v1/bsv/main

# Deployment URLs (for production)
# NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com
# NEXT_PUBLIC_WS_URL=https://your-render-backend.onrender.com
